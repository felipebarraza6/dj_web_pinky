---
import { dj } from '../data/dj';
---

<section class="zones section" id="zonas" data-act-section="afterhours">
  <p class="section__label reveal">{dj.zonesLabel}</p>
  <h2 class="section__title reveal">{dj.zonesTitle}</h2>
  <p class="section__lead reveal">{dj.zonesLead}</p>

  <div class="zones__list">
    {
      dj.zones.map((zone) => (
        <a class="zones__item card-surface reveal" href="#contacto">
          <h3 class="zones__name font-display">{zone.name}</h3>
          <p class="zones__desc">{zone.description}</p>
          <span class="zones__arrow" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .zones__list {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.65rem;
  }

  .zones__item {
    position: relative;
    display: block;
    padding: 1.4rem 1.35rem 1.4rem 1.35rem;
    transition: transform 0.35s ease, border-color 0.35s ease,
      background 0.35s ease;
  }

  .zones__item:hover {
    transform: translateX(6px);
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
    background: color-mix(in oklab, var(--accent-soft) 70%, var(--surface));
  }

  .zones__name {
    margin: 0 0 0.4rem;
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    letter-spacing: -0.02em;
    padding-right: 2rem;
  }

  .zones__desc {
    margin: 0;
    color: var(--fg-muted);
    line-height: 1.55;
    max-width: 42rem;
  }

  .zones__arrow {
    position: absolute;
    top: 1.4rem;
    right: 1.3rem;
    color: var(--accent);
    font-size: 1.2rem;
    transition: transform 0.3s ease;
  }

  .zones__item:hover .zones__arrow {
    transform: translateX(4px);
  }

  @media (min-width: 900px) {
    .zones__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
