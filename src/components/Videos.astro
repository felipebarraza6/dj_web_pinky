---
import { dj } from '../data/dj';
---

<section class="videos section" id="reel" data-act-section="afterhours">
  <p class="section__label reveal">{dj.videosLabel}</p>
  <h2 class="section__title reveal">{dj.videosTitle}</h2>
  <p class="section__lead reveal">{dj.videosLead}</p>

  <div class="videos__grid">
    {
      dj.videos.map((clip) => (
        <article class="videos__card reveal">
          <div class="videos__frame">
            <video
              controls
              playsinline
              preload="metadata"
              poster={clip.poster}
              src={clip.src}
            >
            </video>
          </div>
          <h3 class="videos__name font-display">{clip.title}</h3>
        </article>
      ))
    }
  </div>
</section>

<style>
  .videos__grid {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.9rem;
  }

  .videos__card {
    display: grid;
    gap: 0.85rem;
  }

  .videos__frame {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--border);
    background: #000;
    aspect-ratio: 16 / 9;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  .videos__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 18%, transparent);
    border-radius: inherit;
  }

  .videos__frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .videos__name {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  @media (min-width: 900px) {
    .videos__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
