---
import { dj } from '../data/dj';

const links = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#sobre', label: 'Sobre mí' },
  { href: '#equipo', label: 'Equipo' },
  { href: '#noches', label: 'Noches' },
  { href: '#contacto', label: 'Cotización' },
];
---

<header class="nav" data-nav>
  <a class="nav__brand" href="#inicio" aria-label={dj.brand}>
    <span class="nav__mark" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="22" height="22" fill="none">
        <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="1.6"></circle>
        <circle cx="16" cy="16" r="9.5" stroke="currentColor" stroke-width="1.2" opacity="0.55"></circle>
        <circle cx="16" cy="16" r="3.2" fill="currentColor"></circle>
        <path
          d="M22.5 8.2c2.2 1.1 3.6 3.1 3.8 5.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        ></path>
        <circle cx="26.5" cy="15.2" r="1.6" fill="currentColor"></circle>
      </svg>
    </span>
    <span class="nav__name font-display">{dj.brand}</span>
  </a>

  <nav class="nav__links" aria-label="Principal">
    {
      links.map((link) => (
        <a class="nav__link" href={link.href}>
          {link.label}
        </a>
      ))
    }
  </nav>

  <a class="nav__cta btn btn--primary" href="#contacto">{dj.ctaPrimary}</a>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem clamp(1rem, 3vw, 2.5rem);
    background: color-mix(in oklab, var(--bg-deep) 35%, transparent);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s ease, background 0.4s ease;
  }

  .nav.is-scrolled {
    border-bottom-color: var(--border);
    background: color-mix(in oklab, var(--bg-deep) 72%, transparent);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .nav__mark {
    width: 2.1rem;
    height: 2.1rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
  }

  .nav__name {
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 0.92rem;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 0.2rem;
  }

  .nav__link {
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--fg-muted);
    transition: color 0.25s ease, background 0.25s ease;
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--fg);
    background: var(--surface);
  }

  .nav__cta {
    display: none;
    min-height: 2.35rem;
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
  }

  @media (min-width: 900px) {
    .nav__links {
      display: flex;
    }

    .nav__cta {
      display: inline-flex;
    }
  }
</style>
