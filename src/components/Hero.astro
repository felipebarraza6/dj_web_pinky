---
import { dj } from '../data/dj';
---

<section class="hero" id="inicio" data-act-section="sunset">
  <div class="hero__media" aria-hidden="true">
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      poster={dj.heroMedia.image}
    >
      <source src={dj.heroMedia.video} type="video/mp4" />
    </video>
    <img class="hero__fallback" src={dj.heroMedia.image} alt="" />
    <div class="hero__veil"></div>
  </div>

  <div class="hero__inner section">
    <div class="hero__copy">
      <p class="section__label reveal">{dj.heroEyebrow}</p>
      <h1 class="hero__title font-display reveal">{dj.heroTitle}</h1>
      <p class="hero__lead reveal">{dj.heroLead}</p>
      <div class="hero__actions reveal">
        <a class="btn btn--primary" href="#contacto">{dj.ctaPrimary} →</a>
        <a class="btn btn--ghost" href="#reel">{dj.ctaSecondary}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92svh;
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__video,
  .hero__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    filter: saturate(1.05) contrast(1.04) brightness(0.72);
  }

  .hero__fallback {
    z-index: 0;
  }

  .hero__video {
    z-index: 1;
  }

  /* Veil limpio: scrim fuerte detrás del copy, video sigue full-bleed */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        100deg,
        color-mix(in oklab, var(--bg-deep) 88%, transparent) 0%,
        color-mix(in oklab, var(--bg-deep) 72%, transparent) 28%,
        color-mix(in oklab, var(--bg-deep) 32%, transparent) 52%,
        color-mix(in oklab, var(--bg-deep) 8%, transparent) 72%,
        transparent 88%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--bg-deep) 55%, transparent) 0%,
        color-mix(in oklab, var(--bg-deep) 18%, transparent) 32%,
        color-mix(in oklab, var(--bg-deep) 35%, transparent) 68%,
        color-mix(in oklab, var(--bg-deep) 82%, transparent) 100%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: clamp(5.5rem, 10vw, 7rem);
    padding-bottom: clamp(2.75rem, 6vw, 4rem);
  }

  .hero__copy {
    max-width: 38rem;
  }

  .hero__title {
    margin: 0 0 0.7rem;
    font-size: clamp(2.85rem, 10vw, 5.75rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    font-weight: 800;
    color: var(--fg);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .hero__lead {
    max-width: 30rem;
    margin: 0 0 1.25rem;
    color: color-mix(in oklab, var(--fg) 92%, transparent);
    font-size: clamp(0.98rem, 1.5vw, 1.1rem);
    line-height: 1.55;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
