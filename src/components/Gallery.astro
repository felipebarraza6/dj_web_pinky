---
import { dj } from '../data/dj';
---

<section class="gallery section" id="noches" data-act-section="villa">
  <p class="section__label reveal">{dj.galleryLabel}</p>
  <h2 class="section__title reveal">{dj.galleryTitle}</h2>
  <p class="section__lead reveal">{dj.galleryLead}</p>

  <div class="gallery__grid">
    {
      dj.gallery.map((shot, i) => (
        <article
          class={`gallery__card reveal gallery__card--span-${shot.span}`}
          style={`--i:${i}`}
        >
          <img
            class="gallery__img"
            src={shot.src}
            alt={shot.title}
            loading="lazy"
            decoding="async"
          />
          <div class="gallery__shade" aria-hidden="true"></div>
          <div class="gallery__meta">
            <p class="gallery__act">{shot.act}</p>
            <h3 class="gallery__title font-display">{shot.title}</h3>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .gallery__grid {
    margin-top: 2.25rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .gallery__card {
    position: relative;
    overflow: hidden;
    border-radius: 1.35rem;
    border: 1px solid var(--border);
    min-height: 240px;
    display: grid;
    align-content: end;
    isolation: isolate;
  }

  .gallery__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    filter: saturate(1.12) contrast(1.1) brightness(0.82);
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease;
  }

  .gallery__card:hover .gallery__img {
    transform: scale(1.14);
    filter: saturate(1.2) contrast(1.12) brightness(0.9);
  }

  .gallery__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, 0.72) 100%),
      radial-gradient(
        circle at 80% 10%,
        color-mix(in oklab, var(--accent) 22%, transparent),
        transparent 45%
      );
    pointer-events: none;
  }

  .gallery__meta {
    position: relative;
    z-index: 2;
    padding: 1.2rem 1.25rem;
  }

  .gallery__act {
    margin: 0 0 0.25rem;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-2);
  }

  .gallery__title {
    margin: 0;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  @media (min-width: 720px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery__card--span-2 {
      grid-column: span 2;
      min-height: 320px;
    }
  }

  @media (min-width: 1100px) {
    .gallery__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .gallery__card--span-2 {
      grid-column: span 2;
    }
  }
</style>
