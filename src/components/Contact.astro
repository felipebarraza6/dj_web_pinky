---
import { dj } from '../data/dj';
---

<section class="contact section" id="contacto" data-act-section="afterhours">
  <div class="contact__panel card-surface">
    <p class="section__label reveal">{dj.contactLabel}</p>
    <h2 class="section__title reveal">{dj.contactTitle}</h2>
    <p class="section__lead reveal">{dj.contactLead}</p>

    <form class="contact__form reveal" action="#" method="post" onsubmit="return false;">
      <label>
        <span>Nombre</span>
        <input type="text" name="name" placeholder="Tu nombre" autocomplete="name" />
      </label>
      <label>
        <span>Tipo de evento</span>
        <input type="text" name="event" placeholder="Matrimonio, cumpleaños, villa…" />
      </label>
      <label class="contact__full">
        <span>Fecha tentativa</span>
        <input type="text" name="date" placeholder="Mes / año" />
      </label>
      <label class="contact__full">
        <span>Mensaje</span>
        <textarea name="message" rows="4" placeholder="Cuéntame el vibe que buscas"></textarea>
      </label>
      <div class="contact__actions contact__full">
        <button class="btn btn--primary" type="submit">Enviar demo →</button>
        <a class="btn btn--ghost" href={`mailto:${dj.email}`}>{dj.email}</a>
      </div>
    </form>
  </div>
</section>

<style>
  .contact__panel {
    padding: clamp(1.5rem, 4vw, 2.75rem);
    max-width: 52rem;
  }

  .contact__form {
    margin-top: 1.75rem;
    display: grid;
    gap: 1rem;
  }

  .contact__form label {
    display: grid;
    gap: 0.45rem;
  }

  .contact__form span {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .contact__form input,
  .contact__form textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    background: color-mix(in oklab, var(--bg-deep) 55%, transparent);
    color: var(--fg);
    padding: 0.9rem 1rem;
    font: inherit;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .contact__form input:focus,
  .contact__form textarea:focus {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--border));
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 18%, transparent);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  @media (min-width: 720px) {
    .contact__form {
      grid-template-columns: 1fr 1fr;
    }

    .contact__full {
      grid-column: 1 / -1;
    }
  }
</style>
