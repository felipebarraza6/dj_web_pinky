---
import { dj } from '../data/dj';
---

<a
  class="wa-float"
  href={dj.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={dj.whatsappLabel}
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
    <path
      d="M20.5 3.5A11 11 0 0 0 3.3 17.8L2 22l4.3-1.1A11 11 0 1 0 20.5 3.5Zm-8.6 17a9.1 9.1 0 0 1-4.6-1.3l-.3-.2-2.6.7.7-2.5-.2-.3a9.1 9.1 0 1 1 7 3.6Zm5-6.8c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.2-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5.3-.4c.1-.2 0-.3 0-.5l-.8-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.4s-1 1-1 2.4 1 2.8 1.2 3a10.6 10.6 0 0 0 4 3.5c.5.2 1 .4 1.3.5.6.2 1.1.2 1.5.1.5-.1 1.6-.7 1.8-1.3s.2-1.2.2-1.3-.2-.2-.5-.3Z"
    ></path>
  </svg>
  <span>{dj.whatsappLabel}</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1.05rem;
    border-radius: 999px;
    background: #25d366;
    color: #062414;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: 0 14px 40px rgba(37, 211, 102, 0.35);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .wa-float:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 18px 48px rgba(37, 211, 102, 0.45);
  }
</style>
